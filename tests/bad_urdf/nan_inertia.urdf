<?xml version="1.0"?>
<robot name="nan_bot">
  <link name="base_link"/>
  <link name="arm_link">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="nan" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <joint name="j1" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <limit lower="-1.0" upper="1.0" effort="10.0" velocity="1.0"/>
  </joint>
</robot>
