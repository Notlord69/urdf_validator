<?xml version="1.0"?>
<!--
  ===========================================================================
  synthetic_arm_v14_short_link3 — iteration 3 of the §5.2 flagship scenario:
  synthetic_arm_v14.urdf with link3 SHORTENED BY 50% and nothing else
  changed. Submitted as a full URDF (a geometric change can never be a Tier-2
  override — PRD §3.11 / NFR "Override Safety").

  DIFF vs synthetic_arm_v14.urdf — exactly four numbers:
    1. link3 collision/visual box   1.0 -> 0.5 m  along x
    2. link3 visual/collision origin 0.50 -> 0.25 m
    3. link3 inertial origin (COM)   0.50 -> 0.25 m
    4. joint4 origin                 1.00 -> 0.50 m  (link4 follows link3's tip)
  plus link3's inertia tensor re-derived for the shorter box (so it keeps its
  0% declared-vs-geometry divergence). Masses, efforts and every other link
  are byte-identical to the baseline fixture.

  ===========================================================================
  GEOMETRY (world x, zero pose)   [baseline value in brackets]
  ===========================================================================
    joint1 @ 0.0     link1 @ 0.0    m=1.0  COM @ 0.10
    joint2 @ 0.2     link2 @ 0.2    m=0.5  COM @ 0.25
    joint3 @ 0.3     link3 @ 0.3    m=2.5  COM @ 0.55   [0.80]
    joint4 @ 0.8 [1.3]  link4 @ 0.8 [1.3]  m=0.5  COM @ 0.85   [1.35]

  ===========================================================================
  REQUIRED TORQUE AT joint2 AFTER THE CHANGE (same conventions as baseline)
  ===========================================================================
    tau_joint2 = 9.81 * (0.5*0.05 + 2.5*0.35 + 0.5*0.65)
               = 9.81 * 1.225 = 12.01725 Nm
    margin     = 20.0 / 12.01725 = 1.66427  ->  PASS (was FAIL at 0.9708)

  Equivalently, straight off the baseline's dominant-link sensitivity
  (1.750 g = 17.1675 Nm per unit of scale): shortening link3 by 50% removes
      17.1675 * 0.50 = 8.58375 Nm
      20.60100 - 8.58375 = 12.01725 Nm   (identical, as it must be — the
                                          sensitivity is exact, not a
                                          linearisation)

  ===========================================================================
  §5.2 STEP 4 — compare_reports(baseline_report, this_report)
  ===========================================================================
  api/compare.py derives each lever's *current* value as
  (target_value - gap), then pct_of_gap_closed = (current_b - current_a) / gap_a.

    lever 'effort'      : current == declared effort == 20.0 Nm in BOTH runs
                          (a geometry change moves no motor), so
                          pct_of_gap_closed = 0.0 EXACTLY. The lever's
                          target_value does move, 30.90150 -> 18.02588 Nm
                          (= 1.5 * 12.01725), which compare_reports flags as
                          target_mismatch.

    lever 'moment_arm'  : subtree mass is unchanged at 3.5 kg and so is the
                          declared effort, so the TARGET arm is identical in
                          both runs ((20.0/1.5)/(3.5*9.81) = 0.3883307 m) and
                          the whole movement is in the current value:
                          current_a = 2.100/3.5 = 0.6000000 m
                          current_b = 1.225/3.5 = 0.3500000 m
                          gap_a     = 0.3883307 - 0.6000000 = -0.2116693 m
                          pct_of_gap_closed = (0.3500000 - 0.6000000) / -0.2116693
                                            = 1.1810875
                          i.e. 118.1% of the gap closed — the overshoot that
                          matches joint2 crossing FAIL -> PASS. The same number
                          falls out of the torques directly:
                          (20.60100 - 12.01725) / (20.60100 - 20.0/1.5)
                          = 8.58375 / 7.2676667 = 1.1810875.
  ===========================================================================
-->
<robot name="synthetic_arm_v14_short_link3">

  <!-- base_link: unchanged from synthetic_arm_v14.urdf -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00166667" ixy="0" ixz="0" iyy="0.00166667" iyz="0" izz="0.00166667"/>
    </inertial>
    <visual>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
    </collision>
  </link>

  <!-- link1: unchanged -->
  <link name="link1">
    <inertial>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00106667" ixy="0" ixz="0" iyy="0.00386667" iyz="0" izz="0.00386667"/>
    </inertial>
    <visual>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <geometry><box size="0.2 0.08 0.08"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <geometry><box size="0.2 0.08 0.08"/></geometry>
    </collision>
  </link>

  <!-- link2: unchanged (still 20% inertia divergence — below the 50% flag) -->
  <link name="link2">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00064" ixy="0" ixz="0" iyy="0.00082" iyz="0" izz="0.00082"/>
    </inertial>
    <visual>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry><box size="0.1 0.08 0.08"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry><box size="0.1 0.08 0.08"/></geometry>
    </collision>
  </link>

  <!-- link3: SHORTENED 1.0 -> 0.5 m, mass held at 2.5 kg, COM @ local x=0.25
       re-derived box tensor (still 0% divergence):
       ixx = 2.5/12*(0.0064+0.0064) = 0.00266667
       iyy = izz = 2.5/12*(0.25+0.0064) = 0.05341667 -->
  <link name="link3">
    <inertial>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.00266667" ixy="0" ixz="0" iyy="0.05341667" iyz="0" izz="0.05341667"/>
    </inertial>
    <visual>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.08 0.08"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.08 0.08"/></geometry>
    </collision>
  </link>

  <!-- link4: unchanged (still 200% inertia divergence — above the 50% flag) -->
  <link name="link4">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0016" ixy="0" ixz="0" iyy="0.00205" iyz="0" izz="0.00205"/>
    </inertial>
    <visual>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry><box size="0.1 0.08 0.08"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry><box size="0.1 0.08 0.08"/></geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="60.0" velocity="1.0"/>
  </joint>

  <!-- joint2: same 20.0 Nm motor as the baseline fixture — the geometry
       change alone is what lifts it out of FAIL. -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.2 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20.0" velocity="1.0"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="45.0" velocity="1.0"/>
  </joint>

  <!-- joint4 origin follows link3's shortened tip: 1.0 -> 0.5 -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5.0" velocity="1.0"/>
  </joint>

</robot>
